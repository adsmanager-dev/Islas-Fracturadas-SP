# Sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores e IDE
.idea/
*.code-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/sqfvm-lsp/
.vscode/sqfvm-lsp/*
!.vscode/sqfvm-lsp/ls-ignore.txt

# SQF-VM Language Server
sqlite3.db
sqlite3.db-journal
sqlite3.db-shm
sqlite3.db-wal

# Salidas de Arma 3 y empaquetado
*.pbo
*.ebo
*.bisign
*.biprivatekey
*.rpt
*.bidmp
*.mdmp
*.Arma3Profile
*.vars.Arma3Profile
.hemttout/

# Cachés y copias generadas de misiones
__cur_mp/
mpmissionscache/
missionscache/
*.sqm.bak
*.sqm.old

# Registros, cobertura y resultados de pruebas
*.log
coverage/
test-results/

# Temporales y respaldos locales
*.tmp
*.temp
*.bak
*.swp
*~

# Variables y secretos locales
.env
.env.*
!.env.example

# Metadatos locales de agentes
.codebase-memory/
.serena/

# Material de referencia de terceros (ver asset/PROCEDENCIA.md).
# Nunca es fuente de un asset del proyecto; no se versiona salvo excepción
# explícita registrada en PROCEDENCIA.md con origen, titular y licencia.
# asset/reference/ es la única excepción: material con procedencia y uso
# registrados en PROCEDENCIA.md (mapas base de Altis/Stratis).
asset/*
!asset/PROCEDENCIA.md
!asset/reference/

# Rasterizado intermedio: se regenera con tools/Build-Assets.ps1 desde art/identity/*.svg
art/export/

# Borradores y auditoría local del flujo visual asistido por IA.
# Los manifiestos de procedencia permanecen versionables.
production/media/drafts/
production/media/audit/
tools/if-media-mcp/node_modules/
tools/if-media-mcp/dist/

# Binarios locales de terceros (HEMTT, resvg, VTracer, SQF-VM) para tools/if-media-mcp.
# Se descargan aparte (ver README); no se versionan binarios de plataforma.
tools/if-media-mcp/bin/
