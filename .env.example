# Copiar únicamente a un almacén local seguro o configurar en el entorno del sistema.
# Nunca escribir claves reales en este archivo versionado.
OPENAI_API_KEY=
IF_MEDIA_OPENAI_MODEL=gpt-image-2
IF_MEDIA_MAX_API_CALLS=5
# disabled: Codex usa su generador nativo y el MCP no intenta consumir la API.
# auto: habilita media_generate/media_edit y requiere API con facturación separada.
IF_MEDIA_REMOTE_MODE=disabled
IF_INKSCAPE=
IF_ARMA3_TOOLS=
